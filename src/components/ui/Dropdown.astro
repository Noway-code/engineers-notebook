---
export interface Props {
  label?: string;
  items?: { label: string; href: string }[];
}

const {
  label = "menu",
  items = [
    { label: "home", href: "/" },
    { label: "blog", href: "/blog" },
    { label: "folio", href: "/folio" },
  ],
} = Astro.props;
---

<div class="relative inline-block text-left" data-dropdown>
  <button
    type="button"
    data-dropdown-trigger
    aria-haspopup="true"
    aria-expanded="false"
    class="flex items-center px-4 py-1 text-2xl font-mono font-light text-black transition-colors cursor-pointer"
  >
    {label}
    <svg
      class="h-4 w-4 transition-transform duration-200 data-[open]:rotate-180"
      data-dropdown-icon
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </button>

  <ul
    data-dropdown-menu
    role="menu"
    class="absolute font-mono font-extralight text-xl text-right right-0 hidden "
  >
    {
      items.map((item) => (
        <li role="none">
          <a
            role="menuitem"
            href={item.href}
            class="block px-4 py-1 text-black"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    const icon = dropdown.querySelector<HTMLElement>("[data-dropdown-icon]");
    if (!trigger || !menu) return;

    const close = () => {
      menu.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
      icon?.removeAttribute("data-open");
    };

    const open = () => {
      menu.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
      icon?.setAttribute("data-open", "");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      menu.classList.contains("hidden") ? open() : close();
    });

    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  });
</script>
