---
import Layout from "../../layout/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
  prev: CollectionEntry<"blog">;
  next: CollectionEntry<"blog">;
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

// A bare `2026-09-12` in frontmatter parses as UTC midnight, so format in UTC
// too -- otherwise a machine behind UTC renders the previous day.
const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout title={post.data.title}>
  <div class="absolute bg-hilbert pointer-events-none inset-0"></div>
  <div class="w-full md:w-3/5 mx-auto flex-1 flex flex-col relative gap-4">
    <a
      href={`/blog/`}
      class="min-w-0 font text-port-2 px-6 md:px-12 lg:px-32 font-sans underline underline-offset-2"
    >
      ← all posts
    </a>
    <article class="relative z-10 flex flex-col px-6 md:px-12 lg:px-32 pt-4">
      <p class="font-mono text-sm text-port-3 pb-2">{dateFormat.format(post.data.pubDate)}</p>
      <h1 class="font-serif text-4xl lg:text-5xl text-black">{post.data.title}</h1>
      <div class="flex flex-wrap gap-2 py-2 font-mono text-sm opacity-60">
        {post.data.tags.map((tag) => <a href={`/blog?tag=${tag}`}>#{tag}</a>)}
      </div>
      <hr class="h-px my-2 bg-port-2 border-0" />
      <div class="prose-log font-serif text-lg text-black pb-16">
        <Content />
      </div>
      <!-- Footer -->
      <div class="w-full pb-4 flex flex-col">
        <div class="flex gap-2 pb-2">
          <div
            class="h-14 w-14 relative shrink-0 rounded-full bg-port-4 bg-cover bg-center shadow-[0_5px_10px_rgba(0,0,90,0.15)]"
            style="background-image:url('/Head-small.JPEG')"
            role="img"
            aria-label="Portrait of Camilo Alvarez"
          >
          </div>
          <div class="flex flex-col justify-center">
            <div class="font-sans text-xl/4 font-bold tracking-tight">Camilo Alvarez-Velez</div>
            <div class="font-sans text-md/4 text-port-2">Software Engineer · Lake Mary, FL</div>
          </div>
        </div>
        <hr class="border border-port-5" />
        <div class="flex justify-between pt-2 text-port-2">
          {
            next ? (
              <a href={`/blog/${next.id}/`}>← {next.data.title}</a>
            ) : (
              <a href={`/blog/`}>← all posts</a>
            )
          }
          {
            prev ? (
              <a href={`/blog/${prev.id}/`}> {prev.data.title}→</a>
            ) : (
              <a href={`/blog/`}>all posts→</a>
            )
          }
        </div>
      </div>
    </article>
  </div>
</Layout>

<!-- <Footer /> -->

<style>
  /* Figure numbering runs over the whole post. */
  .prose-log {
    counter-reset: figure;
  }

  .prose-log :global(h2) {
    font-size: 1.5rem;
    margin: 1.25rem 0 0.5rem;
  }
  .prose-log :global(h3) {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }
  .prose-log :global(p) {
    margin: 0.75rem 0;
  }
  .prose-log :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The frame is a transparent border with the graph paper painted behind it:
     a solid border would cover the background, and the photo itself covers
     everything inside the padding edge, so the pattern shows only in the band.
     background-origin lines the grid up with the outer corner. */
  .prose-log :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 5/3;
    object-fit: cover;
    border: 14px solid transparent;
    border-radius: 2px;
    background-color: var(--color-port-2);
    /* A scale bar along the bottom of the frame: minor ticks every 8px, a
       longer one every 40px. Nothing on the other three edges. */
    background-image:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.7) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.4) 0 1px, transparent 1px 8px);
    background-size:
      100% 9px,
      100% 5px;
    background-position:
      left bottom,
      left bottom;
    background-repeat: no-repeat;
    background-origin: border-box;
    background-clip: border-box;
  }

  /* A standalone image is its own <p>; the paragraph after it is the caption. */
  .prose-log :global(p:has(img)) {
    margin-bottom: 0;
  }
  .prose-log :global(p:has(img) + p) {
    counter-increment: figure;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-port-3);
  }
  .prose-log :global(p:has(img) + p)::before {
    content: "Figure " counter(figure) ". ";
  }

  .prose-log :global(figure) {
    margin: 1.5rem 0;
  }
  .prose-log :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-port-3);
  }
</style>
