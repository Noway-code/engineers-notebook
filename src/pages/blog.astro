---
import Layout from "../layout/Layout.astro";
import Footer from "../components/layout/Footer.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const DAY = 1000 * 60 * 60 * 24;
const now = Date.now();

const isRecent = (d: Date) => {
  const age = now - d.getTime();
  return age >= 0 && age <= 14 * DAY;
};
---

<div>
  <Layout title="blog" />
  <div class="mx-auto flex-1 flex flex-col relative">
    <div class="pointer-events-none absolute inset-0"></div>

    <section class="relative z-10 flex flex-col px-6 md:px-12 lg:px-32 py-8">
      <h1 class="flex-1 font-light">blog</h1>
      <hr class="h-px my-2 bg-port-2 border-0" />

      <div class="tag-filters flex flex-wrap gap-2 py-2 font-mono text-sm md:hidden">
        <!-- This is top tags -->
        <button class="tag-btn active" data-tag="all">all</button>
        {
          allTags.map((tag) => (
            <button class="tag-btn" data-tag={tag}>
              {tag}
            </button>
          ))
        }
      </div>

      <div class="flex gap-6 lg:gap-8 items-start">
        <!-- Side bar tags -->
        <aside
          class="tag-filters sticky hidden w-40 shrink-0 flex-col gap-1 font-mono text-lg text-black md:flex lg:w-48"
        >
          <div class="post-card relative text-xl font-mono uppercase pt-2 max-md:hidden">
            <span>/Filter</span>
          </div>
          <button class="tag-btn text-left" data-tag="all">all</button>
          {
            allTags.map((tag) => (
              <button class="tag-btn w-fit text-left" data-tag={tag}>
                {tag}
              </button>
            ))
          }
        </aside>
        <div class="flex min-w-0 flex-1 flex-col">
          <div
            class="post-card relative grid grid-cols-4 gap-4 font-mono uppercase text-xl px-2 pt-2 max-md:hidden"
          >
            <span>/Date</span>
            <span class="col-span-2">/Title</span>
            <span>/Tags</span>
          </div>
          <ul id="post-list" class="grid w-full min-w-0 grid-cols-1 py-2">
            {
              posts.map((post, id) => (
                <li
                  class:list={["post-item group relative flex flex-col bg-white "]}
                  data-tags={post.data.tags.join(",")}
                >
                  <div class="post-card relative grid grid-cols-1  md:grid-cols-4 gap-4 bg-white px-2 py-4 border-b border-port-4">
                    <div class="flex items-center gap-2 font-mono text-xs tracking-wide text-port-3 uppercase ">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {dateFormat.format(post.data.pubDate)}
                      </time>
                      {isRecent(post.data.pubDate) && (
                        <span class="rounded-full bg-port-2/15 px-2 py-0.5 text-port-2">new</span>
                      )}
                    </div>

                    <h2 class="font-serif text-black md:col-span-2 overflow-hidden text-ellipsis text-nowrap">
                      <a
                        href={`/blog/${post.id}`}
                        class="decoration-port-2 text-2xl underline-offset-4 after:absolute after:inset-0 group-hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </h2>

                    <div class="flex flex-wrap gap-x-2 font-mono text-xs text-port-3/80 items-center">
                      {post.data.tags.map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </div>
                  </div>
                  {/* <hr class="border" /> */}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
  <Footer />
</div>

<style>
  .tag-btn {
    cursor: pointer;
    opacity: 0.6;
  }
  .tag-btn.active {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const items = document.querySelectorAll<HTMLLIElement>(".post-item");

  function applyFilter(tag: string) {
    buttons.forEach((b) => b.classList.toggle("active", b.dataset.tag === tag));
    items.forEach((item) => {
      const tags = (item.dataset.tags ?? "").split(",");
      item.hidden = !(tag === "all" || tags.includes(tag));
    });
  }
  // Read ?tag= from the URL on load
  const params = new URLSearchParams(window.location.search);
  applyFilter(params.get("tag") || "all");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tag ?? "all";
      applyFilter(tag);

      const url = new URL(window.location.href);
      if (tag === "all") url.searchParams.delete("tag");
      else url.searchParams.set("tag", tag);
      history.replaceState({}, "", url);
    });
  });

  window.addEventListener("popstate", () => {
    const tag = new URLSearchParams(window.location.search).get("tag") || "all";
    applyFilter(tag);
  });
</script>
