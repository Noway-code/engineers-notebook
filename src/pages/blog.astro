---
import Layout from "../layout/Layout.astro";
import Footer from "../components/layout/Footer.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// A bare `2026-09-12` in frontmatter parses as UTC midnight, so format in UTC
// too -- otherwise a machine behind UTC renders the previous day.
const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const DAY = 1000 * 60 * 60 * 24;
const now = Date.now();

// A post is "recent" for the 14 days after it goes up. Evaluated at build
// time, so the marker is only as fresh as the last deploy.
const isRecent = (d: Date) => {
  const age = now - d.getTime();
  return age >= 0 && age <= 14 * DAY;
};
---

<Layout title="blog">
  <div class="w-full md:w-3/4 mx-auto flex-1 flex flex-col relative border-2 border-port-6">
    <div class="bg-graph pointer-events-none absolute inset-0"></div>

    <section class="relative z-10 flex flex-col px-6 md:px-12 lg:px-32 py-8">
      <h1 class="flex-1 font-light">blog</h1>
      <hr class="h-px my-2 bg-port-2 border-0" />

      <div class="tag-filters flex flex-wrap gap-2 py-2 font-mono text-sm">
        <button class="tag-btn active" data-tag="all">all</button>
        {
          allTags.map((tag) => (
            <button class="tag-btn" data-tag={tag}>
              {tag}
            </button>
          ))
        }
      </div>

      <ul id="post-list" class="grid grid-cols-1 gap-4 pt-4 md:grid-cols-3">
        {
          posts.map((post, id) => (
            <li
              class:list={[
                "post-item group relative flex flex-col overflow-hidden rounded-sm bg-white",
                "ring-1 ring-port-4/70 transition duration-200",
                "hover:-translate-y-0.5 hover:shadow-lg hover:ring-port-2",
                { "md:col-span-2 md:row-span-3": id === 0 },
              ]}
              data-tags={post.data.tags.join(",")}
            >
              <div
                class:list={[
                  "relative w-full shrink-0 overflow-hidden bg-port-1",
                  id === 0 ? "max-h-98 min-h-28 flex-1" : "h-24",
                ]}
              >
                {post.data.cover ? (
                  <Image
                    src={post.data.cover}
                    width={id === 0 ? 900 : 480}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <>
                    <div class="bg-graph pointer-events-none absolute inset-0" />
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-xs tracking-widest text-port-3/70 uppercase">
                      {post.data.tags[0] ?? "note"}
                    </span>
                  </>
                )}
              </div>

              <div class="flex flex-col gap-1 p-3">
                <div class="flex items-center gap-2 font-mono text-xs tracking-wide text-port-3 uppercase">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormat.format(post.data.pubDate)}
                  </time>
                  {isRecent(post.data.pubDate) && (
                    <span class="rounded-full bg-port-2/15 px-2 py-0.5 text-port-2">new</span>
                  )}
                </div>

                <h2
                  class:list={[
                    "font-serif text-black",
                    id === 0 ? "text-2xl lg:text-3xl" : "text-lg leading-snug",
                  ]}
                >
                  <a
                    href={`/blog/${post.id}`}
                    class="decoration-port-2 underline-offset-4 after:absolute after:inset-0 group-hover:underline"
                  >
                    {post.data.title}
                  </a>
                </h2>

                {id === 0 && (
                  <p class="line-clamp-3 font-serif text-base text-port-3">
                    {post.data.description}
                  </p>
                )}

                <div class="flex flex-wrap gap-x-2 font-mono text-xs text-port-3/80">
                  {post.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
  <Footer />
</Layout>

<style>
  /* Cover sits in the bottom half of the card at full strength and dissolves
     upward, so the text end of the card stays clean paper. Absolute, so it
     never affects the card's size; object-cover crops instead of stretching. */
  .card-cover {
    --card-fade: linear-gradient(to top, #000 35%, transparent 100%);
    -webkit-mask-image: var(--card-fade);
    mask-image: var(--card-fade);
  }

  .tag-btn {
    cursor: pointer;
    opacity: 0.6;
  }
  .tag-btn.active {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const items = document.querySelectorAll<HTMLLIElement>(".post-item");

  function applyFilter(tag: string) {
    buttons.forEach((b) => b.classList.toggle("active", b.dataset.tag === tag));
    items.forEach((item) => {
      const tags = (item.dataset.tags ?? "").split(",");
      item.style.display = tag === "all" || tags.includes(tag) ? "" : "none";
    });
  }
  // Read ?tag= from the URL on load
  const params = new URLSearchParams(window.location.search);
  applyFilter(params.get("tag") || "all");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tag ?? "all";
      applyFilter(tag);

      const url = new URL(window.location.href);
      if (tag === "all") url.searchParams.delete("tag");
      else url.searchParams.set("tag", tag);
      history.pushState({}, "", url);
    });
  });
</script>
