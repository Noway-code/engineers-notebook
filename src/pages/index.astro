---
import Layout from "../layout/Layout.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout title="Index">
  <div class="w-2/3 flex-1 mx-auto items-center flex flex-col relative border-2 border-port-6">
    <div class="bg-graph pointer-events-none absolute inset-0"></div>

    <div class="relative z-10 grid flex-1 w-full grid-rows-3">
      <section class="relative flex min-h-0 flex-col justify-center gap-4 px-36">
        <p class="font-mono text-sm text-port-3">
          noway@code <span class="text-port-3">~</span>
          <span class="text-port-2">$</span>
          <span class="text-black text-light pl-1">whoami</span>
        </p>
        <div class="mt-3 flex items-center gap-6">
          <div
            class="h-36 w-36 shrink-0 rounded-full bg-port-4 bg-cover bg-center"
            style="background-image:url('/Head.JPEG')"
            role="img"
            aria-label="Portrait of Camilo Alvarez"
          >
          </div>

          <div class="min-w-0">
            <h1 class="font-sans text-4xl font-bold tracking-tight text-black">Camilo Alvarez</h1>
            <p class="font-sans text-port-2">
              Software Engineering Analyst at BNY &middot; Lake Mary, FL
            </p>
            <hr class="my-2 border-t border-port-4" />
            <p class="font-serif text-lg text-black">
              I like low level code, research, and hacking. Sometime I rant into the
              <a href="/blog" class="underline underline-offset-2 pl-1">void</a>.
            </p>
            <p class="font-serif text-lg text-port-4">// TODO: Write about using AI.</p>
          </div>
        </div>
      </section>
      <section class="min-h-0 px-36 bg-port-2">hello</section>
      <section class="min-h-0 px-36">hello</section>
    </div>
  </div>
  <Footer />
</Layout>
