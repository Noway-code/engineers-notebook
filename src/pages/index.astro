---
import Layout from "../layout/Layout.astro";
import Footer from "../components/layout/Footer.astro";
import { Image } from "astro:assets";
import climbing from "../assets/lead-climbing-rope-choice-climbing.webp";
import { log } from "../data/log.ts";
const recent = {
  label: "What is a harness?",
  description:
    "Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel class aptent taciti sociosqu. Ad litora torquent per conubia nostra inceptos himenaeos.",
  image: "",
  href: "",
  date: " 20, aug, 2026",
};
---

<Layout title="Index">
  <div
    class="w-full max-w-5xl xl:max-w-6xl flex-1 mx-auto items-center flex flex-col relative border-2 border-port-6"
  >
    <div class="bg-graph pointer-events-none absolute inset-0"></div>

    <div class="relative z-10 grid flex-1 w-full lg:grid-rows-[repeat(3,minmax(min-content,1fr))]">
      <section class="relative flex min-h-0 flex-col justify-center gap-4 px-6 md:px-12 lg:px-36">
        <p class="font-mono text-sm text-port-3">
          noway@code <span class="text-port-3">~</span>
          <span class="text-port-2">$</span>
          <span class="text-black font-light pl-1">whoami</span>
        </p>
        <div class="mt-3 flex items-center gap-6">
          <div
            class="h-24 w-24 sm:h-36 sm:w-36 shrink-0 rounded-full bg-port-4 bg-cover bg-center"
            style="background-image:url('/Head.JPEG')"
            role="img"
            aria-label="Portrait of Camilo Alvarez"
          >
          </div>

          <div class="min-w-0">
            <h1 class="font-sans text-3xl sm:text-4xl font-bold tracking-tight text-black">
              Camilo Alvarez
            </h1>
            <p class="font-sans text-port-2">
              Software Engineering Analyst at BNY &middot; Lake Mary, FL
            </p>
            <hr class="my-2 border-t border-port-4" />
            <p class="font-serif text-lg text-black">
              I like low level code, research, and hacking. Sometime I rant into the
              <a href="/blog" class="underline underline-offset-2 pl-1">void</a>.
            </p>
            <p class="font-serif text-lg text-port-4">&lt;!-- TODO: Write about using AI. --&gt;</p>
          </div>
        </div>
      </section>
      <section class="w-full bg-port-2 flex flex-1 justify-between">
        <div class="grid gap-4 py-4 flex-1">
          <!-- DynamicLoad -->
          <ul class="contents text-[#FFFFFF]">
            <li class="flex min-h-0 px-6 md:px-12 lg:px-36">
              <h2 class="font-sans text-base font-light opacity-60 tracking-wide uppercase">
                Latest Post · {recent.date}
              </h2>
            </li>
            <li class="flex flex-col min-h-0 px-6 md:px-12 lg:px-36 font-serif">
              <h1 class="text-4xl lg:text-6xl">{recent.label}</h1>
              <h2 class="text-lg line-clamp-2">{recent.description}</h2>
            </li>
            <li class="min-h-0 px-6 md:px-12 lg:px-36">
              <h2 class="font-sans text-base underline">keep reading -></h2>
            </li>
          </ul>
        </div>
        <div class="relative hidden md:block aspect-square h-full overflow-hidden opacity-60">
          <Image
            src={climbing}
            width={600}
            height={600}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </section>
      <section class="w-full flex flex-1 flex-col px-6 md:px-12 lg:px-36 py-8">
        <div class="flex justify-between w-full">
          <h1 class="flex-1 font-light">log</h1>
          <a href="/docs/Resume.pdf" download="camilo_alvarez_resume" class="text-port-2">
            download resume
          </a>
        </div>
        <hr class="h-px my-2 bg-port-2 border-0" />
        <ul class="flex flex-col gap-2">
          {
            log.map((item, i) => (
              <li class="flex gap-4">
                <div class="flex w-24 shrink-0 gap-2 font-mono font-extralight text-base opacity-70">
                  <span>{item.year}</span>
                  {i === 0 && <span>-</span>}
                </div>

                <div class="w-full min-w-0 flex font-light text-black text-base font-sans gap-x-2">
                  <span class="shrink-0 italic">{item.type}.</span>
                  <span class="min-w-0 flex-1">{item.description}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
  <Footer />
</Layout>
